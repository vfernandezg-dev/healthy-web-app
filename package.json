{
  "name": "healthybites-app",
  "description": "Aplicación web de Healthy Bites: clientes, nutricionistas y administración.",
  "version": "2.0.0-next",
  "private": true,
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "preinstall": "node scripts/only-pnpm.mjs",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:release": "node scripts/check-primeng-license.mjs && ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:e2e": "playwright test",
    "api:sync": "node scripts/api-sync.mjs && pnpm api:gen",
    "api:gen": "node scripts/api-gen.mjs",
    "api:check": "node scripts/api-gen.mjs --check",
    "theme:check": "node scripts/check-theme-tokens.mjs",
    "verify": "pnpm lint && pnpm format:check && pnpm api:check && pnpm theme:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@lucide/angular": "^1.72.0",
    "@primeuix/themes": "^3.1.0",
    "echarts": "^6.1.0",
    "ngx-echarts": "^22.0.0",
    "primeng": "^22.1.4",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.3.5",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@ngx-env/builder": "^22.0.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.18.0"
}
