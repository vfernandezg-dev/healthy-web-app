/* Pruebas E2E (Playwright) y su configuración: solo para comprobar tipos y para el lint con tipos. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/e2e",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["e2e/**/*.ts", "e2e-fullstack/**/*.ts", "playwright*.config.ts"]
}
